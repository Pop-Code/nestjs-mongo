{
    "name": "nestjs-mongo",
    "version": "0.16.0",
    "description": "A NestJS module that provide a simple mongodb orm like",
    "keywords": [
        "nestjs",
        "module",
        "database",
        "mongodb",
        "mongo"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Pop-Code/nestjs-mongo.git"
    },
    "author": "Rmannn <alex.hermann@pop-code.com>",
    "license": "MIT",
    "peerDependencies": {
        "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
        "class-validator": "^0.14.0 || ^0.15.0",
        "mongodb": "^7.0.0",
        "reflect-metadata": "^0.1.13 || ^0.2.0"
    },
    "dependencies": {
        "class-transformer": "^0.5.1",
        "debug": "^4.4.3",
        "lodash": "^4.18.1",
        "slugify": "^1.6.9"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@nestjs/common": "12.5.0",
        "@nestjs/core": "12.5.0",
        "@nestjs/platform-express": "12.5.0",
        "@nestjs/testing": "12.5.0",
        "@types/debug": "4.1.13",
        "@types/jest": "30.0.0",
        "@types/lodash": "4.17.27",
        "@types/node": "26.6.6",
        "class-validator": "0.15.1",
        "eslint": "10.15.0",
        "jest": "30.5.2",
        "mongodb": "7.9.0",
        "prettier": "3.10.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "ts-jest": "29.4.15",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typedoc": "0.28.20",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2"
    },
    "scripts": {
        "build": "rm -Rf ./dist && tsc -b tsconfig.build.json",
        "format": "prettier \"**/*.ts\" --ignore-path ./.prettierignore --write && git status",
        "lint": "eslint ./src ./test",
        "doc": "rm -Rf ./docs && typedoc && touch ./docs/.nojekyll",
        "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
        "test:watch": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
        "test:cov": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand --coverage",
        "test:debug": "node --inspect-brk --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
        "test:smoke": "node -e \"const m = require('./dist'); if (typeof m.MongoModule !== 'function') process.exit(1)\"",
        "prepublishOnly": "npm run build"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".spec.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "src/**/*.ts",
            "!src/index.ts"
        ],
        "coverageDirectory": "./coverage"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "files": [
        "dist",
        "!dist/**/*.tsbuildinfo",
        "CHANGELOG.md",
        "SECURITY.md"
    ],
    "homepage": "https://pop-code.github.io/nestjs-mongo"
}
